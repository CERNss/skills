        },
        "clickhouse_sql": [],
        "promql": []
      },
      "yAxisUnit": "ms"
    },
    {
      "id": "row-errors",
      "panelTypes": "row",
      "title": "Errors / Exceptions"
    },
    {
      "id": "graph-error-trend",
      "panelTypes": "graph",

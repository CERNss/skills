        "clickhouse_sql": [],
        "promql": []
      },
      "nullZeroValues": "zero",
      "opacity": "1",
      "isStacked": false,
      "yAxisUnit": "ms"
    },
    {
      "id": "graph-main-error-or-dependency",
      "panelTypes": "graph",
      "title": "Main Error or Dependency Trend",
      "description": "Use the strongest supporting trend for oncall, such as error trend, consumer latency, or dependency error trend",

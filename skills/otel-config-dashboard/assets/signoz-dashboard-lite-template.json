{
  "name": "<repo_name> Dashboard Name (Lite)",
  "description": "Generic one-page SigNoz lite dashboard for oncall health inspection and fast drilldown.",
  "tags": [
    "<repo_name>",
    "signoz",
    "otel",
    "lite"
  ],
  "version": "v4",
  "variables": {
    "service.name": {
      "name": "service.name",
      "type": "DYNAMIC",
      "selectedValue": "",
      "multiSelect": true,
      "description": "Filter by service name when the field exists"
    },
    "deployment.environment": {
      "name": "deployment.environment",
      "type": "DYNAMIC",
      "selectedValue": "",
      "multiSelect": false,
      "description": "Filter by environment when the field exists"
    }
  },
  "layout": [
    {
      "h": 1,
      "i": "row-lite-overview",
      "minH": 1,
      "minW": 12,
      "w": 12,
      "x": 0,
      "y": 0
    },
    {
      "h": 3,
      "i": "value-throughput",
      "w": 3,
      "x": 0,
      "y": 1
    },
    {
      "h": 3,
      "i": "value-error-rate",
      "w": 3,
      "x": 3,
      "y": 1
    },
    {
      "h": 3,
      "i": "value-p95-latency",
      "w": 3,
      "x": 6,
      "y": 1
    },
    {
      "h": 3,
      "i": "value-critical-dependency",
      "w": 3,
      "x": 9,
      "y": 1
    },
    {
      "h": 5,
      "i": "graph-main-latency",
      "w": 6,
      "x": 0,
      "y": 4
    },
    {
      "h": 5,
      "i": "graph-main-error-or-dependency",
      "w": 6,
      "x": 6,
      "y": 4
    },
    {
      "h": 5,
      "i": "graph-slow-traces-or-fallback",
      "w": 6,
      "x": 0,
      "y": 9
    },
    {
      "h": 5,
      "i": "graph-failed-traces-or-fallback",
      "w": 6,
      "x": 6,
      "y": 9
    }
  ],
  "widgets": [
    {
      "id": "row-lite-overview",
      "panelTypes": "row",
      "title": "一屏总览（值班核心健康信号）"
    },
    {
      "id": "value-throughput",
      "panelTypes": "value",
      "title": "Throughput",
      "description": "Replace with the main throughput metric from the metrics contract",
      "query": {
        "id": "lite-throughput-q",
        "queryType": "builder",
        "builder": {
          "queryData": [],
          "queryFormulas": []
        },
        "clickhouse_sql": [],
        "promql": []
      },
      "yAxisUnit": "reqps"
    },
    {
      "id": "value-error-rate",
      "panelTypes": "value",
      "title": "Error Rate",
      "description": "Replace with the main error-rate metric from the metrics contract",
      "query": {
        "id": "lite-error-rate-q",
        "queryType": "builder",
        "builder": {
          "queryData": [],
          "queryFormulas": []
        },
        "clickhouse_sql": [],
        "promql": []
      },
      "yAxisUnit": "percent"
    },
    {
      "id": "value-p95-latency",
      "panelTypes": "value",
      "title": "P95 Latency",
      "description": "Replace with the main latency percentile from the metrics contract",
      "query": {
        "id": "lite-p95-latency-q",
        "queryType": "builder",
        "builder": {
          "queryData": [],
          "queryFormulas": []
        },
        "clickhouse_sql": [],
        "promql": []
      },
      "yAxisUnit": "ms"

        "id": "lite-critical-dependency-q",
        "queryType": "builder",
        "builder": {
          "queryData": [],
          "queryFormulas": []
        },
        "clickhouse_sql": [],
        "promql": []
      },
      "yAxisUnit": "percent"
    },
    {
      "id": "graph-main-latency",
      "panelTypes": "graph",
      "title": "Main Latency Trend",
      "description": "Use the most important latency trend for oncall visibility",
      "query": {
        "id": "lite-main-latency-q",
        "queryType": "builder",
        "builder": {
          "queryData": [],
          "queryFormulas": []
